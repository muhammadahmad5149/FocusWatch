# ScreenGuardian environment example
# Copy this file to .env for local development defaults.
#
# Important:
# - Email upload is disabled unless SCREEN_GUARDIAN_EMAIL_ENABLED=true.
# - The Electron dashboard can change these settings after first run.
# - Do not commit a real .env file with SMTP passwords.

# Windows data root.
# Typical structure:
# C:\ProgramData\ScreenGuardian\
#   screenshots\
#   logs\
#   config\
SCREEN_GUARDIAN_DATA_DIR=C:\ProgramData\ScreenGuardian

# Screenshot scheduler interval range.
SCREEN_GUARDIAN_MIN_INTERVAL_MINUTES=1
SCREEN_GUARDIAN_MAX_INTERVAL_MINUTES=3

# Email reporting defaults.
SCREEN_GUARDIAN_EMAIL_ENABLED=false
SCREEN_GUARDIAN_EMAIL_FROM=guardian@example.com
SCREEN_GUARDIAN_EMAIL_TO=admin@example.com

# SMTP settings used only when email reporting is enabled.
SCREEN_GUARDIAN_SMTP_HOST=smtp.example.com
SCREEN_GUARDIAN_SMTP_PORT=587
SCREEN_GUARDIAN_SMTP_SECURE=false
SCREEN_GUARDIAN_SMTP_USER=guardian@example.com
SCREEN_GUARDIAN_SMTP_PASS=replace-with-app-password
